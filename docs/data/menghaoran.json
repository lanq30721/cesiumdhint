。"],[16,"想像若在眼，"],[17,"周流空复情。"],[18,"谢公还欲卧，"],[19,"谁与济苍生。"]],"50114":[[0,"朝游访名山，"],[1,"山远在空翠。"],[2,"氛氲亘百里，"],[3,"日入行始至。"],[4,"杖策寻故人，"],[5,"解鞭暂停骑。"],[6,"石门殊豁险，"],[7,"篁迳转森邃。"],[8,"法侣欣相逢，"],[9,"清谈晓不寐。"],[10,"平生慕真隐，"],[11,"累日探奇异。"],[12,"野老朝入田，"],[13,"山僧暮归寺。"],[14,"松泉多逸响，"],[15,"苔壁饶古意。"],[16,"谷口闻钟声，"],[17,"林端识香气。"],[18,"愿言投此山，"],[19,"身世两相弃。"]],"50200":[[0,"清晓因兴来，"],[1,"乘流越江岘。"],[2,"沙禽近方识，"],[3,"浦树遥莫辨。"],[4,"渐至鹿门山，"],[5,"山明翠微浅。"],[6,"岩潭多屈曲，"],[7,"舟檝屡回转。"],[8,"昔闻庞德公，"],[9,"采药遂不返。"],[10,"金涧饵芝术，"],[11,"石床卧苔藓。"],[12,"纷吾感耆旧，"],[13,"结揽事攀践。"],[14,"隐迹今尚存，"],[15,"高风邈已远。"],[16,"白云何时去，"],[17,"丹桂空偃蹇。"],[18,"探讨意未穷，"],[19,"回艇夕阳晚。"]],"50315":[[0,"维先自邹鲁，"],[1,"家世重儒风。"],[2,"诗体袭遗训，"],[3,"趋庭霑末躬。"],[4,"昼夜常自强，"],[5,"词翰颇亦工。"],[6,"三十既成立，"],[7,"嗟吁命不通。"],[8,"慈亲向羸老，"],[9,"喜惧在深衷。"],[10,"甘脆朝不足，"],[11,"箪瓢夕屡空。"],[12,"执鞭慕夫子，"],[13,"捧檄怀毛公。"],[14,"感激遂弹冠，"],[15,"安能守固穷。"],[16,"当途诉知己，"],[17,"投剌匪求蒙。"],[18,"秦楚邈离异，"],[19,"飜飞何日同。"]],"50471":[[0,"韩公是襄士，"],[1,"日赏城西岑。"],[2,"结搆意不浅，"],[3,"岩潭趣转深。"],[4,"皇华一动咏，"],[5,"荆国几谣吟。"],[6,"旧径兰勿剪，"],[7,"新堤柳欲阴。"],[8,"砌傍余怪石，"],[9,"沙上有闲禽。"],[10,"自牧豫章郡，"],[11,"空瞻枫树林。"],[12,"因声寄流水，"],[13,"善听在知音。"],[14,"耆旧眇不接，"],[15,"崔徐无处寻。"],[16,"物情多贵远，"],[17,"贤俊岂无今。"],[18,"迟尔长江暮，"],[19,"澄清一洗心。"]],"50668":[[0,"当昔襄阳雄盛时，"],[1,"山公常醉习家池。"],[2,"池边钓女日相随，"],[3,"妆成照影竞来窥。"],[4,"澄波澹澹芙蓉发，"],[5,"绿岸毵毵杨柳垂。"],[6,"一朝物变人亦非，"],[7,"四面荒凉人径稀。"],[8,"意气豪华何处在，"],[9,"空余草露湿罗衣。"],[10,"此地朝来饯行者，"],[11,"翻向此中牧征马。"],[12,"征马分飞日渐斜，"],[13,"见此空为人所嗟。"],[14,"殷勤为访桃源路，"],[15,"予亦归来松子家。"]],"50804":[[0,"予奉垂堂诫，"],[1,"千金非所轻。"],[2,"为多山水乐，"],[3,"频作泛舟行。"],[4,"五岳追向子，"],[5,"三湘吊屈平。"],[6,"湖经洞庭阔，"],[7,"江入新安清。"],[8,"复闻严陵濑，"],[9,"乃在兹湍路。"],[10,"叠障数百里，"],[11,"沿洄非一趣。"],[12,"彩翠相氛氲，"],[13,"别流乱奔注。"],[14,"钓矶平可坐，"],[15,"苔磴滑难步。"],[16,"猨饮石下潭，"],[17,"鸟还日边树。"],[18,"观奇恨来晚，"],[19,"倚櫂惜将暮。"],[20,"挥手弄潺湲，"],[21,"从兹洗尘虑。"]],"51160":[[0,"南陌春将晚，"],[1,"北窗犹卧病。"],[2,"林园久不游，"],[3,"草木一何盛。"],[4,"狭迳花障迷，"],[5,"闲庭竹扫净。"],[6,"翠羽戏兰苕，"],[7,"赪鳞动荷柄。"],[8,"念我平生好，"],[9,"江乡远从政。"],[10,"云山阻梦思，"],[11,"衾枕劳歌咏。"],[12,"歌咏复何为，"],[13,"同心恨别离。"],[14,"世途皆自媚，"],[15,"流俗寡相知。"],[16,"贾谊才空逸，"],[17,"安仁鬓欲丝。"],[18,