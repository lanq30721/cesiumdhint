,"山河入嵩汝。"],[6,"蒲轮去渐遥，"],[7,"石径徒延伫。"]],"31369":[[0,"逆旅相逢处，"],[1,"江村日暮时。"],[2,"众山遥对酒，"],[3,"孤屿共题诗。"],[4,"廨宇邻蛟室，"],[5,"人烟接岛夷。"],[6,"乡园万余里，"],[7,"失路一相悲。"]],"31498":[[0,"邑有弦歌宰，"],[1,"翔鸾狎野鸥。"],[2,"眷言华省旧，"],[3,"暂拂海池游。"],[4,"郁岛藏深竹，"],[5,"前溪对舞楼。"],[6,"更闻书即事，"],[7,"云物是清秋。"]],"31618":[[0,"采樵入深山，"],[1,"山深树重叠。"],[2,"桥崩卧槎拥，"],[3,"路险垂藤接。"],[4,"日落伴将稀，"],[5,"山风拂萝衣。"],[6,"长歌负轻策，"],[7,"平野望烟归。"]],"31627":[[0,"释子弥天秀，"],[1,"将军武库才。"],[2,"横行塞北尽，"],[3,"独步汉南来。"],[4,"贝叶传金口，"],[5,"山楼作赋开。"],[6,"因君振嘉藻，"],[7,"江楚气雄哉。"]],"32044":[[0,"闺夕绮窗闭，"],[1,"佳人罢缝衣。"],[2,"理琴开宝匣，"],[3,"就枕卧重帏。"],[4,"夜久灯花落，"],[5,"薰笼香气微。"],[6,"锦衾重自煖，"],[7,"遮莫晓霜飞。"]],"32053":[[0,"闻君息阴地，"],[1,"东郭柳林间。"],[2,"左右瀍涧水，"],[3,"门庭缑氏山。"],[4,"抱琴来取醉，"],[5,"垂钓坐乘闲。"],[6,"归客莫相待，"],[7,"寻源殊未还。"]],"32062":[[0,"闻君驰彩骑，"],[1,"躞蹀指南荆。"],[2,"为结潘杨好，"],[3,"言过鄢郢城。"],[4,"摽梅诗有赠，"],[5,"羔雁礼将行。"],[6,"今夜神仙女，"],[7,"应来感梦情。"]],"32065":[[0,"闻就庞公隐，"],[1,"移居近洞湖。"],[2,"兴来林是竹，"],[3,"归卧谷名愚。"],[4,"挂席樵风便，"],[5,"开轩琴月孤。"],[6,"岁寒何用赏，"],[7,"霜落故园芜。"]],"32123":[[0,"阮籍推名饮，"],[1,"清风满竹林。"],[2,"半酣下衫袖，"],[3,"拂拭龙唇琴。"],[4,"一杯弹一曲，"],[5,"不觉夕阳沈。"],[6,"予意在山水，"],[7,"闻之谐夙心。"]],"32504":[[0,"风吹沙海雪，"],[1,"渐作柳园春。"],[2,"宛转随香骑，"],[3,"轻盈伴玉人。"],[4,"歌疑郢中客，"],[5,"态比洛川神。"],[6,"今日南归楚，"],[7,"双飞似入秦。"]],"32971":[[0,"龙沙豫章北，"],[1,"九日挂帆过。"],[2,"风俗因时见，"],[3,"湖山发兴多。"],[4,"客中谁送酒，"],[5,"櫂里自成歌。"],[6,"歌竟乘流去，"],[7,"滔滔任夕波。"]],"32976":[[0,"龙象经行处，"],[1,"山腰度石关。"],[2,"屡迷青嶂合，"],[3,"时爱绿萝闲。"],[4,"宴息花林下，"],[5,"高谈竹屿间。"],[6,"寥寥隔尘事，"],[7,"疑是入鸡山。"]],"33470":[[0,"雾辟天光远，"],[1,"春回日道临。"],[2,"草浓河畔色，"],[3,"槐结路旁阴。"],[4,"欲映君王史，"],[5,"先标胄子襟；"],[6,"经明如何拾，"],[7,"自有致云心。"]],"34413":[[0,"山光忽西落，"],[1,"池月渐东上。"],[2,"散发乘夕凉，"],[3,"开轩卧闲敞。"],[4,"荷风送香气，"],[5,"竹露滴清响。"],[6,"欲取鸣琴弹，"],[7,"恨无知音赏。"],[8,"感此怀故人，"],[9,"中宵劳梦想。"]],"34796":[[0,"蔓草蔽极野，"],[1,"兰芝结孤根。"],[2,"众音何其繁，"],[3,"伯牙独不喧。"],[4,"当时高深意，"],[5,"举世无能分。"],[6,"钟期一见知，"],[7,"山水千秋闻。"],[8,"尔其保静节，"],[9,"薄俗徒云云。"]],"35381":[[0,"万岁楼头望故乡，"],[1,"独令乡思更茫茫。"],[2,"天寒雁度堪垂泪，"],[3,"日落猿啼欲断肠。"],[4,"曲引古堤临冻浦，"],[5,"斜分远岸近枯杨。"],[6,"今朝偶见同袍友，"],[7,"却喜家书寄八行。"]],"36031":[[0,"五更钟漏欲相催，"],[1,"四气推迁往复回。"],[2,"帐里残灯才去熖，"],[3,"炉中香气尽成灰。"],[4,"渐看春逼芙蓉枕，"],[5,"顿觉寒销竹叶杯。"],[6,"守岁家家应未卧，"],[7,"相思那得梦魂来。"]],"36996":[[0,"县城南面汉江流，"],[1,"江涨开成南雍州。"],[2,"才子乘春来骋望，"],[3,"群公暇日坐销忧。"],[4,"楼台晚映青山郭，"],[5,"罗绮晴骄绿水洲。"],[6,"向夕波摇明月动，"],[7,"更疑神女弄珠游。"]],"37911":[[0,"山寺钟鸣昼已昏，"],[1,"渔梁渡头争渡喧。"],[2,"人随沙路向江村，"],[3,"余亦乘舟归鹿门。"],[4,"鹿门月照开烟树，"],[5,"忽到庞公栖隐处。"],[6,"岩扉松径长寂寥，"],[7,"惟有幽人夜来去。"]],"38957":[[0,"昔时风景登临地，"],[1,"今日衣冠送别筵。"],[2,"醉坐自倾彭泽酒，"],[3,"思归长望白云天。"],[4,"洞庭一叶惊秋早，"],[5,"濩落空嗟滞江岛。"],[6,"寄语朝廷当世人，"],[7,"何时重见长安道。"]],"40932":[[0,"秦城旧来称窈窕，"],[1,"汉家更衣应不少。"],[2,"红粉邀君在何处，"],[3,"青楼苦夜长难晓。"],[4,"长乐宫中钟暗来，"],[5,"可怜歌舞惯相催。"],[6,"欢娱此事今寂寞，"],[7,"惟有年年陵树哀。"]],"42835":[[0,"青楼晓日珠帘映，"],[1,"红粉春妆宝镜催。"],[2,"已厌交欢怜枕席，"],[3,"相将游戏绕池台。"],[4,"坐时衣带萦纤草，"],[5,"行即裙裾扫落梅。"],[6,"更道明朝不当作，"],[7,"相期共鬬管弦来。"]],"43595":[[0,"君不见巫山神女作行云，"],[1,"霏红沓翠晓氛氲。"],[2,"婵娟流入楚王梦，"],[3,"倏忽还随零雨分。"],[4,"空中飞去复飞来，"],[5,"朝朝暮暮下阳台。"],[6,"愁君此去为仙尉，"],[7,"便逐行云去不回。"]],"43858":[[0,"上德如流水，"],[1,"安仁道若山。"],[2,"闻君秉高节，"],[3,"而得奉清颜。"],[4,"鸿渐升仪羽，"],[5,"牛刀列下班。"],[6,"处腴能不润，"],[7,"居剧体常闲。"],[8,"去诈人无谄，"],[9,"除邪吏息奸。"],[10,"欲知清与洁，"],[11,"明月照澄湾。"]],"43909":[[0,"东旭早光芒，"],[1,"渚禽已惊聒。"],[2,"卧闻渔浦口，"],[3,"桡声暗相拨。"],[4,"日出气象分，"],[5,"始知江湖阔。"],[6,"美人常晏起，"],[7,"照影弄流沫。"],[8,"饮水畏惊猿，"],[9,"祭鱼时见獭。"],[10,"舟行自无闷，"],[11,"况值晴景豁。"]],"43954":[[0,"久废南山田，"],[1,"叨陪东阁贤。"],[2,"欲随平子去，"],[3,"犹未献甘泉。"],[4,"枕籍琴书满，"],[5,"褰帷远岫连。"],[6,"我来如昨日，"],[7,"庭树忽鸣蝉。"],[8,"促织惊寒女，"],[9,"秋风感长年。"],[10,"授衣当九月，"],[11,"无褐竟谁怜。"]],"43974":[[0,"习公有遗坐，"],[1,"高在白云陲。"],[2,"樵子不见识，"],[3,"山僧赏自知。"],[4,"以余为好事，"],[5,"携手一来窥。"],[6,"竹露闲夜滴，"],[7,"松风清昼吹。"],[8,"从来抱微尚，"],[9,"况复感前规。"],[10,"于此无奇策，"],[11,"苍生奚以为。"]],"44167":[[0,"关戍惟东井，"],[1,"城池起北辰。"],[2,"咸歌太平日，"],[3,"共乐建寅春。"],[4,"雪尽青山树，"],[5,"冰开黑水滨。"],[6,"草迎金埒马，"],[7,"花伴玉楼人。"],[8,"鸿渐看无数，"],[9,"莺歌听欲频。"],[10,"何当遂荣擢，"],[11,"归及柳条新。"]],"44265":[[0,"北山白云里，"],[1,"隐者自怡悦。"],[2,"相望试登高，"],[3,"心飞逐鸟灭。"],[4,"愁因薄暮起，"],[5,"兴是清秋发。"],[6,"时见归村人，"],[7,"沙行渡头歇。"],[8,"天边树若荠，"],[9,"江畔舟如月。"],[10,"何当载酒来，"],[11,"共醉重阳节。"]],"44288":[[0,"半空跻宝塔，"],[1,"晴望尽京华。"],[2,"竹遶渭川遍，"],[3,"山连上苑斜。"],[4,"四门开帝宅，"],[5,"阡陌俯人家。"],[6,"累劫从初地，"],[7,"为童忆聚沙。"],[8,"一窥功德见，"],[9,"弥益道心加。"],[10,"坐觉诸天近，"],[11,"空香送落花。"]],"44521":[[0,"大江分九流，"],[1,"淼淼成水乡。"],[2,"舟子乘利涉，"],[3,"往来至浔阳。"],[4,"因之泛五湖，"],[5,"流浪经三湘。"],[6,"观涛壮枚发，"],[7,"吊屈痛沈湘。"],[8,"魏阙心恒在，"],[9,"金门诏不忘。"],[10,"遥怜上林雁，"],[11,"冰泮也回翔。"]],"44714":[[0,"山水观形胜，"],[1,"襄阳美会稽。"],[2,"最高唯望楚，"],[3,"曾未一攀跻。"],[4,"石壁疑削成，"],[5,"众山比全低。"],[6,"晴明试登陟，"],[7,"目极无端倪。"],[8,"云梦掌中小，"],[9,"武陵花处迷。"],[10,"暝还归骑下，"],[11,"萝月映深谿。"]],"44723":[[0,"岘山南郭外，"],[1,"送别每登临。"],[2,"沙岸江村近，"],[3,"松门山寺深。"],[4,"一言予有赠，"],[5,"三峡尔将寻。"],[6,"祖席宜城酒，"],[7,"征途云梦林。"],[8,"蹉跎游子意，"],[9,"眷恋故人心。"],[10,"去矣勿淹滞，"],[11,"巴东猿夜吟。"]],"44724":[[0,"岘山江岸曲，"],[1,"郢水郭门前。"],[2,"自古登临处，"],[3,"非今独黯然。"],[4,"亭楼明落照，"],[5,"井邑秀通川。"],[6,"涧竹生幽兴，"],[7,"林风入管弦。"],[8,"再飞鹏激水，"],[9,"一举鹤冲天。"],[10,"伫立三荆使，"],[11,"看君驷马旋。"]],"44834":[[0,"异县天隅僻，"],[1,"孤帆海畔过。"],[2,"往来乡信断，"],[3,"留滞客情多。"],[4,"腊月闻雷震，"],[5,"东风感岁和。"],[6,"蛰虫惊户穴，"],[7,"巢鹊眄庭柯。"],[8,"徒对芳尊酒，"],[9,"其如伏枕何。"],[10,"归屿理舟楫，"],[11,"江海正无波。"]],"44893":[[0,"念尔习诗礼，"],[1,"未曾违户庭。"],[2,"平生早偏露，"],[3,"万里更飘零。"],[4,"坐弃三牲养，"],[5,"行观八阵形。"],[6,"饰装辞故里，"],[7,"谋策赴边庭。"],[8,"壮志吞鸿鹄，"],[9,"遥心伴鹡鸰。"],[10,"所从文且武，"],[11,"不战自应宁。"]],"44912":[[0,"悠悠清水江，"],[1,"水落沙屿出。"],[2,"回潭石下深，"],[3,"绿筿岸傍密。"],[4,"鲛人潜不见，"],[5,"渔父歌自逸。"],[6,"忆与君别时，"],[7,"泛舟如昨日。"],[8,"夕阳开返照，"],[9,"中坐兴非一。"],[10,"南望鹿门山，"],[11,"归来恨如失。"]],"44944":[[0,"我行滞宛许，"],[1,"日夕望京豫。"],[2,"旷野莽茫茫，"],[3,"乡山在何处。"],[4,"孤烟村际起，"],[5,"归雁天边去。"],[6,"积雪复平臯，"],[7,"饥鹰捉寒兔。"],[8,"少年弄文墨，"],[9,"属意在章句。"],[10,"十上耻还家，"],[11,"裴回守归路。"]],"45089":[[0,"明发览群物，"],[1,"万木何阴森。"],[2,"凝霜渐渐水，"],[3,"庭橘似悬金。"],[4,"女伴争攀摘，"],[5,"摘窥碍叶深。"],[6,"竝生怜共蒂，"],[7,"相示感同心。"],[8,"骨刺红罗被，"],[9,"香黏翠羽簪。"],[10,"擎来玉盘里，"],[11,"全胜在幽林。"]],"45158":[[0,"晚憩支公室，"],[1,"故人逢右军。"],[2,"轩窗避炎暑，"],[3,"翰墨动新文。"],[4,"竹蔽簷前日，"],[5,"雨随堦下云。"],[6,"周游清荫徧，"],[7,"吟卧夕阳曛。"],[8,"江静櫂歌歇，"],[9,"溪深樵语闻。"],[10,"归途未忍去，"],[11,"携手恋清芬。"]],"45414":[[0,"洞庭去远近，"],[1,"枫叶早惊秋。"],[2,"岘首羊公爱，"],[3,"长沙贾谊愁。"],[4,"土毛无缟纻，"],[5,"乡味有槎头。"],[6,"已抱沈痼疾，"],[7,"更贻魑魅忧。"],[8,"数年同笔砚，"],[9,"兹夕间衾裯。"],[10,"意气今何在，"],[11,"相思望斗牛。"]],"45488":[[0,"漾舟寻水便，"],[1,"因访故人居。"],[2,"落日清川里，"],[3,"谁言独羡鱼。"],[4,"石潭窥洞彻，"],[5,"沙岸历纡徐。"],[6,"竹屿见垂钓，"],[7,"茅斋闻读书。"],[8,"款言忘景夕，"],[9,"清兴属